digraph ER {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.9", splines=polyline];
node [shape=plain, fontname="DejaVu Sans", fontsize=11];
edge [fontname="DejaVu Sans", fontsize=10, color="#718096"];
organizations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#e9ede7"><B>Организация / organizations</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER · PK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">TEXT · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">inn</TD><TD ALIGN="LEFT">TEXT · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">kpp</TD><TD ALIGN="LEFT">TEXT · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT">TEXT · NOT NULL</TD></TR></TABLE>>];
periods [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#e9ede7"><B>Расчётные периоды / periods</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER · PK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">organization_id</TD><TD ALIGN="LEFT">INTEGER · FK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">year</TD><TD ALIGN="LEFT">INTEGER · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">month</TD><TD ALIGN="LEFT">INTEGER · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">norm_override</TD><TD ALIGN="LEFT">INTEGER · NULL</TD></TR></TABLE>>];
positions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#e9ede7"><B>Должности и тарифы / positions</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER · PK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">organization_id</TD><TD ALIGN="LEFT">INTEGER · FK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">TEXT · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">name_key</TD><TD ALIGN="LEFT">TEXT · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">base_rate</TD><TD ALIGN="LEFT">NUMERIC(20, 2) · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">seniority_percent</TD><TD ALIGN="LEFT">NUMERIC · NOT NULL</TD></TR></TABLE>>];
employees [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#e9ede7"><B>Сотрудники / employees</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER · PK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">organization_id</TD><TD ALIGN="LEFT">INTEGER · FK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">position_id</TD><TD ALIGN="LEFT">INTEGER · FK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">TEXT · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">inn</TD><TD ALIGN="LEFT">TEXT · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">hire_date</TD><TD ALIGN="LEFT">DATE · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">experience_years</TD><TD ALIGN="LEFT">INTEGER · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">rate_per_shift</TD><TD ALIGN="LEFT">NUMERIC(20, 2) · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">dismissal_date</TD><TD ALIGN="LEFT">DATE · NULL</TD></TR></TABLE>>];
timesheets [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#e9ede7"><B>Табели / timesheets</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER · PK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">period_id</TD><TD ALIGN="LEFT">INTEGER · FK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">shift_norm</TD><TD ALIGN="LEFT">INTEGER · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">revision</TD><TD ALIGN="LEFT">INTEGER · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">closed</TD><TD ALIGN="LEFT">BOOLEAN · NOT NULL</TD></TR></TABLE>>];
payroll_statements [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#e9ede7"><B>Ведомости / payroll_statements</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER · PK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">timesheet_id</TD><TD ALIGN="LEFT">INTEGER · FK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">organization_name</TD><TD ALIGN="LEFT">TEXT · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">source_revision</TD><TD ALIGN="LEFT">INTEGER · NOT NULL</TD></TR></TABLE>>];
timesheet_entries [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#e9ede7"><B>Строки табеля / timesheet_entries</B></TD></TR><TR><TD ALIGN="LEFT">timesheet_id</TD><TD ALIGN="LEFT">INTEGER · PK FK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">employee_id</TD><TD ALIGN="LEFT">INTEGER · PK FK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">worked_shifts</TD><TD ALIGN="LEFT">INTEGER · NULL</TD></TR><TR><TD ALIGN="LEFT">sick_days</TD><TD ALIGN="LEFT">INTEGER · NULL</TD></TR><TR><TD ALIGN="LEFT">vacation_days</TD><TD ALIGN="LEFT">INTEGER · NULL</TD></TR></TABLE>>];
payroll_results [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#e9ede7"><B>Результаты и снимки / payroll_results</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INTEGER · PK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">statement_id</TD><TD ALIGN="LEFT">INTEGER · FK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">employee_id</TD><TD ALIGN="LEFT">INTEGER · FK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">TEXT · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">inn</TD><TD ALIGN="LEFT">TEXT · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">position_name</TD><TD ALIGN="LEFT">TEXT · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">hire_date</TD><TD ALIGN="LEFT">DATE · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">dismissal_date</TD><TD ALIGN="LEFT">DATE · NULL</TD></TR><TR><TD ALIGN="LEFT">experience_years</TD><TD ALIGN="LEFT">INTEGER · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">rate_per_shift</TD><TD ALIGN="LEFT">NUMERIC(20, 2) · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">worked_shifts</TD><TD ALIGN="LEFT">INTEGER · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">sick_days</TD><TD ALIGN="LEFT">INTEGER · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">vacation_days</TD><TD ALIGN="LEFT">INTEGER · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">accrued</TD><TD ALIGN="LEFT">NUMERIC(20, 2) · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">tax</TD><TD ALIGN="LEFT">NUMERIC(20, 2) · NOT NULL</TD></TR><TR><TD ALIGN="LEFT">amount_to_pay</TD><TD ALIGN="LEFT">NUMERIC(20, 2) · NOT NULL</TD></TR></TABLE>>];
organizations -> positions [label="1 : N"];
organizations -> employees [label="1 : N"];
organizations -> periods [label="1 : N"];
positions -> employees [label="1 : N"];
periods -> timesheets [label="1 : 0..1"];
timesheets -> timesheet_entries [label="1 : N"];
employees -> timesheet_entries [label="1 : N"];
timesheets -> payroll_statements [label="1 : 0..1"];
